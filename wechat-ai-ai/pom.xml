<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.wechatai</groupId>
        <artifactId>wechat-ai-assistant</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>
    <artifactId>wechat-ai-ai</artifactId>
    <name>wechat-ai-ai</name>
    <description>AI 引擎模块 — LangChain4j / LangGraph4j 编排</description>

    <dependencies>
        <dependency>
            <groupId>com.wechatai</groupId>
            <artifactId>wechat-ai-common</artifactId>
        </dependency>
        <dependency>
            <groupId>com.wechatai</groupId>
            <artifactId>wechat-ai-session</artifactId>
        </dependency>
        <dependency>
            <groupId>com.wechatai</groupId>
            <artifactId>wechat-ai-document</artifactId>
        </dependency>
        <dependency>
            <groupId>com.wechatai</groupId>
            <artifactId>wechat-ai-tool</artifactId>
        </dependency>
        <dependency>
            <groupId>com.wechatai</groupId>
            <artifactId>wechat-ai-agent</artifactId>
        </dependency>
        <dependency>
            <groupId>com.wechatai</groupId>
            <artifactId>wechat-ai-proactive</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.mybatis.spring.boot</groupId>
            <artifactId>mybatis-spring-boot-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>dev.langchain4j</groupId>
            <artifactId>langchain4j</artifactId>
        </dependency>
        <dependency>
            <groupId>dev.langchain4j</groupId>
            <artifactId>langchain4j-open-ai</artifactId>
        </dependency>
        <dependency>
            <groupId>org.bsc.langgraph4j</groupId>
            <artifactId>langgraph4j-core</artifactId>
        </dependency>

        <!-- DashScope TTS（阿里云百炼语音合成） -->
        <dependency>
            <groupId>com.alibaba</groupId>
            <artifactId>dashscope-sdk-java</artifactId>
            <version>${dashscope.version}</version>
            <exclusions>
                <exclusion>
                    <groupId>org.slf4j</groupId>
                    <artifactId>slf4j-api</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>org.slf4j</groupId>
                    <artifactId>slf4j-simple</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
    </dependencies>
</project>
