{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "wechat-ai-desktop",
  "version": "0.1.0",
  "identifier": "com.wechatai.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "小微",
        "width": 1100,
        "height": 700,
        "resizable": true,
        "fullscreen": false,
        "theme": "Light",
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "nsis",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
